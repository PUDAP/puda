NATS_SERVERS=nats://localhost:4222
MACHINE_PREFIX=test

# Optional: pin a single instance instead of {prefix}-1
# MACHINE_ID=test-1

# Optional: comma-separated IDs (overrides prefix/count)
# MACHINE_IDS=alpha,beta,gamma

# Optional: start N instances named {prefix}-1 .. {prefix}-N in one process
# COUNT=3

# Optional simulated latency applied to most commands (seconds)
FAKE_COMMAND_DELAY=1
