# NATS (plaintext: nats:// URLs, leave PUDA_NATS_CA and PUDA_E2E_KEY_FILE unset)
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
# TLS + E2E payload encryption: set BOTH and use tls:// URLs, e.g.
# NATS_SERVERS=tls://bears:4222,tls://bears:4223,tls://bears:4224
# PUDA_NATS_CA=/etc/puda/ca.pem
# PUDA_E2E_KEY_FILE=/etc/puda/e2e/lab.key

# PostgreSQL client
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=puda
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
