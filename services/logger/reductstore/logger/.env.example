# NATS (comma-separated; all nats:// for plaintext or all tls:// for E2EE)
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224

# E2EE (TLS + payload encryption): set both, or neither for plaintext.
# Host paths; compose mounts them into the container.
# PUDA_NATS_CA=/path/to/ca.pem
# PUDA_E2E_KEY_FILE=/path/to/e2e.key

# ReductStore
REDUCTSTORE_URL=http://bearsnas:8383
REDUCTSTORE_TOKEN=reduct
REDUCTSTORE_BUCKET=puda
